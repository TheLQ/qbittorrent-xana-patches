debug: Enable qDebug in build

From: Leon Blakey <code@leonblakey.com>


---
 cmake/Modules/CommonConfig.cmake |    3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/cmake/Modules/CommonConfig.cmake b/cmake/Modules/CommonConfig.cmake
index 000000..000000 100644
--- a/cmake/Modules/CommonConfig.cmake
+++ b/cmake/Modules/CommonConfig.cmake
@@ -28,7 +28,8 @@ target_compile_definitions(qbt_common_cfg INTERFACE
     QT_NO_NARROWING_CONVERSIONS_IN_CONNECT
     QT_USE_QSTRINGBUILDER
     QT_STRICT_ITERATORS
-    $<$<NOT:$<CONFIG:Debug>>:QT_NO_DEBUG_OUTPUT>
+    # Enable qDebug in release mode
+    # $<$<NOT:$<CONFIG:Debug>>:QT_NO_DEBUG_OUTPUT>
 )
 
 if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")

 QVariantMap serialize(const BitTorrent::Torrent &torrent)
 {
+    QVariantMap result;
+    serialize_torrent_to(torrent, KEYS_TORRENT_ALL, [&](const QString& key, QVariant value) {
+        result.insert(key, value);
+    });
+    return result;
+}
+
+QVariantList serialize_array(const BitTorrent::Torrent &torrent, const QList<QString> &torrent_keys)
+{
+    QVariantList result;
+    result.reserve(torrent_keys.size());
+    serialize_torrent_to(torrent, torrent_keys, [&](const QString&, QVariant value) {
+        result.append(value);
+    });
+    return result;
+}
